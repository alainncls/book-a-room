{
  "name": "book-a-room",
  "version": "1.0.0",
  "description": "DApp to book rooms",
  "repository": "git@github.com:alainncls/book-a-room.git",
  "main": "index.js",
  "scripts": {
    "start": "webpack serve --progress --color --open",
    "build": "webpack",
    "build:prod": "webpack --mode production",
    "test": "mocha -r ts-node/register 'test/**/*spec*'",
    "test:watch": "mocha -r ts-node/register 'test/**/*spec*' --recursive --watch --watch-files src/**/*.ts,test/**/*.*s",
    "test:coverage": "nyc mocha -r ts-node/register 'test/**/*spec*'"
  },
  "author": "Alain Nicolas",
  "license": "ISC",
  "dependencies": {
    "core-js": "3.50.0",
    "ethers": "5.8.0",
    "lit-html": "3.3.3",
    "noty": "3.2.0-beta-deprecated",
    "page": "1.11.6"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/register": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@istanbuljs/nyc-config-babel": "3.0.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "babel-loader": "9.2.1",
    "babel-plugin-istanbul": "6.1.1",
    "chai": "4.5.0",
    "clean-webpack-plugin": "4.0.0",
    "copy-webpack-plugin": "12.0.2",
    "css-loader": "6.11.0",
    "html-webpack-plugin": "5.6.8",
    "mocha": "10.8.2",
    "nyc": "15.1.0",
    "style-loader": "3.3.4",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "webpack": "5.110.3",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.2.6"
  }
}
